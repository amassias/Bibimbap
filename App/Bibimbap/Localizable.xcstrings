          "stringUnit": {
            "state": "translated",
            "value": "Chaque macro occupe l'emplacement du bouton auquel elle est affectée. Assignez la fonction « Macro » à un bouton dans Personnaliser pour en créer une."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each macro occupies the slot of the button it is assigned to. Assign the Macro function to a button in Customize to create one."
          }
        }
      }
    },
